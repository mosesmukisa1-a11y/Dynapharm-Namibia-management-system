modules = ["web", "bash", "python-3.12", "nodejs-20", "postgresql-16"]
[agent]
expertMode = true
integrations = ["javascript_object_storage:2.0.0"]

[nix]
channel = "stable-25_05"
packages = ["awscli2"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx vite"
waitForPort = 5000

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=3001 STARTUP_MODE=code-only ALLOW_SCHEMA_SYNC=false ALLOW_REFERENCE_SEEDS=false ALLOW_INVENTORY_SEED=false ALLOW_STOCK_SUMMARY_DDL=false ENABLE_STOCK_SCHEDULER=false ENABLE_STOCK_HEALTH_DIGEST=false node server.js"
waitForPort = 3001

[userenv]

[userenv.shared]

[userenv.development]
B2_BACKUP_OUTPUT_DIR = "/tmp/b2-ciphertext-d65f6582-fb6d-401b-86e7-3829f0b3e013"
B2_BACKUP_PG_ROOT_CERT = "/etc/ssl/certs/ca-certificates.crt"
B2_BACKUP_SOURCE_CLASS = "production"

[userenv.production]
ALLOW_INVENTORY_SEED = "false"
ALLOW_REFERENCE_SEEDS = "false"
ALLOW_SCHEMA_SYNC = "false"
ALLOW_STOCK_SUMMARY_DDL = "false"
ENABLE_STOCK_HEALTH_DIGEST = "false"
ENABLE_STOCK_SCHEDULER = "false"
STARTUP_MODE = "code-only"
WORKER_APPROVAL_ESCALATION = "false"
WORKER_DAILY_SUMMARY = "false"
WORKER_DRIFT_DETECTION = "false"
WORKER_DRIFT_REPAIR = "false"
WORKER_ENABLED = "false"
WORKER_EXPIRY_SCAN = "false"
WORKER_HEALTH_DIGEST = "false"
WORKER_MONTHLY_SUMMARY = "false"
WORKER_RECEIPT_REMINDERS = "false"
WORKER_REDISTRIBUTION = "false"
WORKER_REORDER_REQUESTS = "false"
WORKER_SCHEDULED_PRICE_ACTIVATION = "false"
WORKER_STUCK_APPROVALS = "false"
WORKER_SUMMARY_BACKFILL = "false"
WORKER_WEEKLY_SUMMARY = "false"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "scripts/start-code-only-web.mjs"]
build = ["npx", "vite", "build"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[[ports]]
localPort = 3001
externalPort = 80

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 3003
externalPort = 3003

[[ports]]
localPort = 3004
externalPort = 3000

[[ports]]
localPort = 3005
externalPort = 6800

[[ports]]
localPort = 3006
externalPort = 8008

[[ports]]
localPort = 3007
externalPort = 8081

[[ports]]
localPort = 3009
externalPort = 9000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 5174
externalPort = 4200

[[ports]]
localPort = 5175
externalPort = 6000

[[ports]]
localPort = 5176
externalPort = 8000

[[ports]]
localPort = 5177
externalPort = 8080

[[ports]]
localPort = 5178
externalPort = 8099

[objectStorage]
defaultBucketID = "replit-objstore-097cc06d-8ed8-4a37-9a4a-5d839924f13d"
