{
  "name": "dynapharm-cloud",
  "version": "2.0.0",
  "description": "Dynapharm International Namibia - Cloud Health Management System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:vite": "npx vite",
    "build": "npx vite build",
    "preview": "npx vite preview",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:db": "node scripts/run-isolated-stock-audit.mjs",
    "test:db:all": "node scripts/run-isolated-stock-audit.mjs --all",
    "install:dev": "npm install --include=dev",
    "auto-commit": "node tools/auto-commit.js",
    "guard": "node tools/guard-inline-events.js",
    "seed:users": "node scripts/seed-users.js",
    "seed:users:file": "node scripts/seed-users.js --file",
    "migrate:user-passwords": "node scripts/migrate-user-passwords.js",
    "import:local-users": "node scripts/import-local-users.js"
  },
  "keywords": [
    "healthcare",
    "management",
    "namibia",
    "dynapharm",
    "medical"
  ],
  "author": "Moses Mukisa",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "python": ">=3.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mosesmukisa1-a11y/dynapharm-cloud.git"
  },
  "bugs": {
    "url": "https://github.com/mosesmukisa1-a11y/dynapharm-cloud/issues"
  },
  "homepage": "https://dynapharm-cloud.vercel.app",
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@replit/object-storage": "^1.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@uppy/aws-s3": "^5.1.0",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.1",
    "@uppy/react": "^5.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cookie": "^0.7.2",
    "date-fns": "^4.1.0",
    "express": "^4.22.3",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.577.0",
    "multer": "^2.3.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.5.207",
    "pg": "^8.16.3",
    "postcss": "^8.5.29",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.0",
    "rollup": "^4.59.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.4",
    "wouter": "^3.9.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "chokidar": "^4.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-html": "^8.1.2",
    "eslint-plugin-import": "^2.29.1",
    "globals": "^15.9.0",
    "jsdom": "^24.1.3",
    "minimatch": "^3.1.4",
    "playwright": "^1.56.1",
    "prettier": "^3.3.3",
